ErrorDocument 404 /404/

<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|svg|webp|avif|png|jpg|jpeg|gif|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|xml|txt)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml text/javascript image/svg+xml font/ttf font/opentype
</IfModule>

AddType application/javascript .js
AddType text/css .css
AddType image/webp .webp
AddType image/avif .avif

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
